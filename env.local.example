# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API Keys
# https://supabase.com/dashboard/project/_/settings/api
#
# Cloud Agents: add the same names in Cursor → Cloud Agents → Secrets instead of
# committing .env.local. See docs/cloud-agent-setup.md and .cursor/secrets.example.env

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (sb_publishable_...) or legacy anon (eyJ...) — safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret (sb_secret_...) or legacy service_role (eyJ...) — server/scripts only, never commit
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (migrations; Cloud Agent secrets) ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Vercel CLI (optional; main-branch git push usually triggers deploy) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
