# Copy these names into Cursor → Cloud Agents → Secrets (Runtime Secret for tokens/passwords).
# Do not commit real values. See docs/cloud-agent-setup.md.

# --- Supabase (app + operator scripts) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (migrations / SQL) ---
# Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# Project Settings → General → Reference ID (also the subdomain of SUPABASE_URL)
SUPABASE_PROJECT_REF=
# Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=
# Optional: direct Postgres URL for one-off SQL (Settings → Database → Connection string)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Vercel (optional manual prod deploy; main-branch git push usually enough) ---
# https://vercel.com/account/tokens
VERCEL_TOKEN=
# Project Settings → General (only needed for `vercel deploy --prod` without linking)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Optional operator tools ---
OPENAI_API_KEY=
